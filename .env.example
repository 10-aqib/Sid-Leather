# Public URL of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.sidleather.com

# Where inquiry emails are delivered (comma-separated for several).
INQUIRY_TO=sales@sidleather.com

# ---- Option A: Resend (https://resend.com) ----
# The "from" domain must be verified in Resend (e.g. add sidleather.com).
RESEND_API_KEY=
INQUIRY_FROM="SID Leather Website <website@sidleather.com>"

# ---- Option B: SMTP (e.g. your cPanel / Google Workspace / Zoho mailbox) ----
# Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
